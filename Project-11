#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static long long cnt;

static void gap_insertion(int a[], int n, int gap)
{
    for (int i = gap; i < n; i++) {
        int tmp = a[i];
        int j = i;
        while (j >= gap) {
            cnt++;
            if (a[j - gap] > tmp) {
                a[j] = a[j - gap];
                j -= gap;
            } else {
                break;
            }
        }
        a[j] = tmp;
    }
}

static long long insertion_sort(int a[], int n)
{
    cnt = 0;
    gap_insertion(a, n, 1);
    return cnt;
}

static long long shell_original(int a[], int n)
{
    cnt = 0;
    for (int h = n / 2; h >= 1; h /= 2)
        gap_insertion(a, n, h);
    return cnt;
}

static long long shell_knuth(int a[], int n)
{
    cnt = 0;
    int h = 1;
    while (3 * h + 1 < n)
        h = 3 * h + 1;
    for (; h >= 1; h = (h - 1) / 3)
        gap_insertion(a, n, h);
    return cnt;
}

static int is_sorted(const int a[], int n)
{
    for (int i = 1; i < n; i++)
        if (a[i - 1] > a[i]) return 0;
    return 1;
}

int main(void)
{
    int sizes[] = {1000, 2000, 4000, 8000, 16000, 20000};
    int num = sizeof(sizes) / sizeof(sizes[0]);

    srand((unsigned)time(NULL));

    for (int s = 0; s < num; s++) {
        int n = sizes[s];
        int *orig = malloc(sizeof(int) * n);
        int *work = malloc(sizeof(int) * n);

        for (int i = 0; i < n; i++)
            orig[i] = rand();

        memcpy(work, orig, sizeof(int) * n);
        long long c1 = insertion_sort(work, n);
        int ok1 = is_sorted(work, n);

        memcpy(work, orig, sizeof(int) * n);
        long long c2 = shell_original(work, n);
        int ok2 = is_sorted(work, n);

        memcpy(work, orig, sizeof(int) * n);
        long long c3 = shell_knuth(work, n);
        int ok3 = is_sorted(work, n);

        printf("Data Size : %d\n\n", n);
        printf("Insertion Sort       : %lld comparisons\n", c1);
        printf("Shell Sort (Original): %lld comparisons\n", c2);
        printf("Shell Sort (Knuth)   : %lld comparisons\n", c3);
        if (!(ok1 && ok2 && ok3))
            printf("[오류] 정렬 결과가 올바르지 않습니다!\n");
        printf("\n");

        free(orig);
        free(work);
    }
    return 0;
}
